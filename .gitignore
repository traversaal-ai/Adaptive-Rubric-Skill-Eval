# AdaRubric output — run artifacts. There should only be ONE canonical `output/`; this pattern
# also catches any stray numbered dirs (output2/, output3/, …) left over from ad-hoc test runs.
results/
output*/
*.log

# Generated dashboard report (built from output/ by dashboard/generate.py; template.html is tracked)
dashboard/report.html

# Cloned datasets (large; not part of the repo)
dataset/

# Internal port log / working notes (not part of the published repo)
converting/
understanding/

# Tests (kept local, not published)
tests/
