# AdaRubric keys — copy this file to `.env`, fill in what you have, never commit `.env`.
# Pass it to every run:   uv run adarubric run <task> --env-file .env
# Only the key the RUNNING agent needs enters its sandbox; judge keys stay on your machine.

# ---- agent keys (one is enough to start) -----------------------------------
ANTHROPIC_API_KEY=            # runs --harness claude-code (and acp + claude-code-acp)
GEMINI_API_KEY=               # runs --harness gemini-cli  (and acp + 'gemini --acp')
OPENAI_API_KEY=               # runs --harness codex       (and acp + codex-acp)
TOGETHER_API_KEY=             # runs --harness claude-code-together / codex-together
                              # (open models via TogetherLink — Beta, pin --model to a
                              #  Together model id). Also usable as a judge provider.

# ---- the judge, chosen SEPARATELY from the agent (all optional) ------------
# Without these: the judge is the first key found above (gemini -> anthropic -> openai
# -> together). With them: every judge (fixed / static / adaptive) and rubric generation
# uses exactly this — e.g. agent on Together, judge on gemini, or the reverse.
JUDGE_LLM_PROVIDER=           # gemini | anthropic | openai | together
JUDGE_API_KEY=                # the judge's own key; else the provider's normal key above is used
JUDGE_MODEL=                  # optional exact judge model (else the provider's default)
